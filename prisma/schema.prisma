// Prisma schema for Whisp (MVP)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl=env("DIRECT_URL")
}

//
// USERS TABLE
//
model User {
  id          String      @id @default(uuid())
  username    String      @unique
  email       String?     @unique
  password    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // relations
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  whisperA         Whisper[] @relation("WhisperA")
  whisperB         Whisper[] @relation("WhisperB")
}

//
// WHISPERS TABLE (friend connection)
//
model Whisper {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  status    WhisperStatus  @default(PENDING)
  createdAt DateTime @default(now())

  userA   User @relation("WhisperA", fields: [userAId], references: [id])
  userB   User @relation("WhisperB", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
}

enum WhisperStatus {
  PENDING
  ACCEPTED
}

//
// MESSAGES TABLE (encrypted messages)
//
model Message {
  id           String   @id @default(uuid())
  senderId     String
  receiverId   String

  // AES-GCM encrypted fields
  cipherText   String   // encrypted message blob (base64)
  iv           String   // initialization vector
  tag          String   // auth tag

  type         MessageType @default(TEXT)
  createdAt    DateTime @default(now())

  // relations
  sender       User @relation("SentMessages", fields: [senderId], references: [id])
  receiver     User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

enum MessageType {
  TEXT
  IMAGE
  FILE
}